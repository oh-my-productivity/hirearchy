{
  "name": "hirearchy-study-p1-I1-assistant",
  "description": "internal: hirearchy usability study P1 stream I1 assistant; deleted after the stream",
  "mcpServers": {
    "hirearchy": {
      "command": "uv",
      "args": ["--directory", "/Volumes/workspace/hirearchy", "run", "hirearchy", "mcp"],
      "env": { "ORG_ROOT": "/tmp/hirearchy-p1-I1-1793136275/org" }
    }
  },
  "tools": ["*"],
  "permissions": {
    "rules": [
      { "capability": "all", "effect": "allow" }
    ]
  },
  "resources": [
    "skill:///Volumes/workspace/hirearchy/skills/hirearchy/SKILL.md",
    "skill://.kiro/skills/*/SKILL.md"
  ],
  "hooks": [],
  "includeMcpJson": false,
  "model": "claude-sonnet-5.5"
}
