{
  "name": "hirearchy-acme-org-1a2b3c-read-shell-write-x0badf00d",
  "description": "internal: used by the hirearchy scheduler for /Users/u/acme/org; not a general-purpose agent (built-in tools: read, shell, write)",
  "prompt": "You are a member of a file-based agent organization. The user message contains your rules, charter, memory, state and new messages for this run. Follow it exactly, act through the hirearchy tools, and stop when the messages are handled. The hirearchy tools are deferred: load them with tool_load (tool_ids [\"hirearchy::*\"] loads all of them), then call each with tool_call and tool_id \"hirearchy::<name>\", for example hirearchy::whoami. Where the rules say @hirearchy/<name>, use hirearchy::<name>.",
  "mcpServers": {
    "hirearchy": {
      "command": "/venv/bin/hirearchy",
      "args": [
        "mcp"
      ],
      "env": {
        "ORG_ROOT": "/Users/u/acme/org",
        "ORG_REQUIRE_AGENT": "1"
      }
    }
  },
  "tools": [
    "@hirearchy",
    "read",
    "write",
    "shell"
  ],
  "resources": [],
  "hooks": [],
  "includeMcpJson": false,
  "includePowers": false,
  "permissions": {
    "rules": [
      {
        "capability": "mcp",
        "match": [
          "hirearchy/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow",
        "match": [
          "/Users/u/proj",
          "/Users/u/proj/**",
          "/Users/u/handbook",
          "/Users/u/handbook/**",
          "/Users/u/acme/org",
          "/Users/u/acme/org/**"
        ]
      },
      {
        "capability": "fs_write",
        "effect": "allow",
        "match": [
          "/Users/u/proj/**"
        ]
      },
      {
        "capability": "fs_write",
        "effect": "deny",
        "match": [
          "/Users/u/acme/org",
          "/Users/u/acme/org/**"
        ]
      },
      {
        "capability": "fs_read",
        "effect": "deny",
        "match": [
          "/**"
        ],
        "exclude": [
          "/Users/u/proj",
          "/Users/u/proj/**",
          "/Users/u/handbook",
          "/Users/u/handbook/**",
          "/Users/u/acme/org",
          "/Users/u/acme/org/**"
        ]
      },
      {
        "capability": "fs_write",
        "effect": "deny",
        "match": [
          "/**"
        ],
        "exclude": [
          "/Users/u/proj/**"
        ]
      },
      {
        "capability": "fs_write",
        "effect": "deny",
        "match": [
          "/Users/u/proj/.kiro",
          "/Users/u/proj/.kiro/**",
          "/Users/u/proj/**/.kiro",
          "/Users/u/proj/**/.kiro/**",
          "/Users/u/proj/AGENTS.md",
          "/Users/u/proj/**/AGENTS.md",
          "/Users/u/proj/.git",
          "/Users/u/proj/.git/**",
          "/Users/u/proj/**/.git",
          "/Users/u/proj/**/.git/**",
          "/Users/u/proj/.vscode",
          "/Users/u/proj/.vscode/**",
          "/Users/u/proj/**/.vscode",
          "/Users/u/proj/**/.vscode/**"
        ]
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "deny"
      },
      {
        "capability": "context",
        "effect": "deny"
      }
    ]
  }
}
